# URL du backend NestJS (sans slash final)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Clé de chiffrement pour redux-persist (CryptoJS) — générer une chaîne aléatoire longue
NEXT_PUBLIC_CRYPTO_SECRET=changeme_use_a_long_random_string_here

# URL publique du frontend (utilisée pour sitemap.xml et robots.txt)
NEXT_PUBLIC_SITE_URL=https://ton-domaine.com

# Multi-tenance SaaS (backend branche aurel-saas uniquement) : à activer UNIQUEMENT
# si NEXT_PUBLIC_API_URL pointe vers un déploiement backend multi-tenant (dont le CORS
# allowedHeaders inclut 'X-Tenant-Slug'). Sur un backend non multi-tenant, 
# NE PAS activer : le navigateur bloquerait toutes les requêtes (preflight
# CORS rejeté, en-tête non whitelisté côté serveur).
# NEXT_PUBLIC_MULTI_TENANT_BACKEND=true

# Si le flag ci-dessus est actif : slug de l'organisation, déduit automatiquement du
# sous-domaine en production (client1.monapp.com → "client1"), rien à configurer.
# En développement local (hostname "localhost" ou IP, aucun sous-domaine) : renseigner
# ici le slug d'une Organisation existante en base pour tester le flux multi-tenant.
# NEXT_PUBLIC_DEV_TENANT_SLUG=client1
